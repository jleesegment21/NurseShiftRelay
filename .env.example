# Twilio Credentials
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Number the nurses see on caller ID (and can call back)
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Human staffing coordinator — transfers and failed sessions are dialed here
STAFFING_COORDINATOR_NUMBER=+1xxxxxxxxxx

# Hospital / agent branding
HOSPITAL_NAME=Mercy General Hospital
AGENT_NAME=Ava

# OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Campaign behaviour
# How many nurses to ring at once for a single shift. First "yes" wins;
# still-ringing calls are cancelled as soon as the shift is filled.
CALL_CONCURRENCY=3
# Send an SMS confirmation when a nurse accepts (requires A2P 10DLC / toll-free verification)
SEND_SMS_CONFIRMATION=false

# Optional: ElevenLabs voice for ConversationRelay (blank = Twilio default)
TTS_VOICE=

# Security
# Required as the x-api-key header on /campaign and /shifts when set
ADMIN_API_KEY=
# Validate X-Twilio-Signature on webhooks. Set to false only for local curl testing.
VALIDATE_TWILIO_SIGNATURE=true

# Server
# Set this to your ngrok URL after running:
#   ngrok http 8080
SERVER_URL=https://your-subdomain.ngrok-free.app
PORT=8080
